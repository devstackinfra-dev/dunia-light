# ─────────────────────────────────────────────────────────────────────────────
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Banco de dados ──────────────────────────────────────────────────────────
# O projeto roda sobre Postgres. Hoje via Supabase, que entrega banco, login e
# arquivos de uma vez. Para migrar a um Postgres próprio no futuro, só os
# repositórios em src/lib/db/ mudam — nenhum componente fala com o banco direto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo de servidor. IGNORA o RLS — nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/keep-alive, que impede o plano gratuito do Supabase de pausar
# o projeto. Na Vercel, o cron do vercel.json já envia este segredo sozinho.
# Gere um valor aleatório longo (ex.: openssl rand -hex 32).
CRON_SECRET=

# ─── Identidade do cliente ───────────────────────────────────────────────────
# Define o vocabulário da interface e as perguntas de qualificação do lead.
# Valores aceitos: catalogo | juridico | generico
NEXT_PUBLIC_VERTICAL=generico

# Jurídico: o painel confere os textos contra o Provimento 205/2021 da OAB.
# false (padrão): mostra as vedações e pede confirmação antes de salvar.
# true: uma vedação grave (promessa de resultado, "consulta gratuita"...)
#       impede salvar o texto.
NEXT_PUBLIC_COMPLIANCE_BLOQUEIO=false

NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LEGAL_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Contato (aparece no site e nos links de WhatsApp) ───────────────────────
# Apenas dígitos com DDI. Ex.: 5511999999999
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# ─── Profissional responsável (jurídico) ─────────────────────────────────────
# Usados no hero e no rodapé. A página própria dele(a) e a biografia são
# editadas no painel (Página Inicial → Textos do site).
NEXT_PUBLIC_BRAND_PERSON=
NEXT_PUBLIC_BRAND_REGISTRATION=
NEXT_PUBLIC_BRAND_CITY=
NEXT_PUBLIC_BRAND_PHOTO=
NEXT_PUBLIC_BRAND_PHOTO_ABOUT=
# Foto larga (2400×1000 ou maior) no fundo do hero, com a pessoa à direita.
# Vazio: hero com o retrato emoldurado (NEXT_PUBLIC_BRAND_PHOTO).
NEXT_PUBLIC_BRAND_HERO_PHOTO=
# Fotos de ambiente (2400×1400 ou maior), separadas por vírgula. Viram faixas
# com parallax entre as seções da home, na ordem dada. Vazio: sem faixas.
NEXT_PUBLIC_BRAND_PARALLAX=

# ─── Imagens da marca ────────────────────────────────────────────────────────
# URLs do Supabase Storage (bucket logos). Vazio: o nome da marca em texto.
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_LOGO_LIGHT=
NEXT_PUBLIC_BRAND_OG_IMAGE=

# ─── Cores ───────────────────────────────────────────────────────────────────
# Vazio: paleta padrão da vertical. SEMPRE entre aspas: sem elas o "#" vira
# comentário e a cor é ignorada em silêncio. (No painel da Vercel, sem aspas.)
NEXT_PUBLIC_THEME_INK=
NEXT_PUBLIC_THEME_PANEL=
NEXT_PUBLIC_THEME_ACCENT=
NEXT_PUBLIC_THEME_SURFACE=
NEXT_PUBLIC_THEME_MUTED=
# Par de fontes: caslon-publicsans (padrão) ou playfair-opensans
NEXT_PUBLIC_THEME_FONTS=

# ─── Redes sociais (vazio oculta o ícone) ────────────────────────────────────
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
